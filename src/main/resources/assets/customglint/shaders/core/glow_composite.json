        { "name": "SearchRadius", "type": "int", "count": 1, "values": [ 3 ] },
        { "name": "ThicknessScale", "type": "float", "count": 1, "values": [ 1.0 ] },
        { "name": "ProjA", "type": "float", "count": 1, "values": [ 1.0 ] },
        { "name": "ProjB", "type": "float", "count": 1, "values": [ 1.0 ] },
        { "name": "TargetId", "type": "int", "count": 1, "values": [ -1 ] },
        { "name": "GuiMode", "type": "int", "count": 1, "values": [ 0 ] }
    ]
}
